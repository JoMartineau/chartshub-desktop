# Preserve the exact reviewed UTF-8 source bytes used for deterministic builds.
# The optional package deliberately includes an original CRLF MODULE.json.
/quick-import-mod/** -text
# The reviewed Windows manifest retains CRLF; other whitespace checks still apply.
/quick-import-mod/MODULE.json whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
