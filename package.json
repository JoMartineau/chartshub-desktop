{
  "name": "chartshub-desktop",
  "productName": "ChartsHub",
  "version": "0.14.11",
  "private": true,
  "description": "ChartsHub pour Windows, macOS et Linux — téléchargement natif des charts",
  "main": "main.js",
  "scripts": {
    "test": "node --require ./tests/setup.cjs --test --test-timeout=60000 tests/*.test.js",
    "start": "electron .",
    "package": "node build.mjs",
    "build:companion": "tsc -p tsconfig.companion.json",
    "typecheck": "tsc -p tsconfig.companion.json --noEmit",
    "test:companion:duplicates": "npm run build:companion && electron tests/companion-duplicates-electron.cjs",
    "test:companion:catalogue-widget": "npm run build:companion && electron tests/companion-catalogue-widget-electron.cjs",
    "pretest": "npm run build:companion",
    "prestart": "npm run build:companion",
    "start:companion": "npm run build:companion && electron . --companion",
    "prepackage": "npm run build:companion"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "24.10.1",
    "electron": "44.4.5",
    "typescript": "5.9.3"
  },
  "author": "ChartsHub",
  "license": "UNLICENSED",
  "dependencies": {
    "ws": "8.22.0"
  }
}
